{
  "name": "purrfectui",
  "version": "0.1.0",
  "private": true,
  "description": "Animated React components for shadcn projects. Install with the shadcn CLI or copy the source.",
  "homepage": "https://purrfectui.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vaibhav91one/purrfect-ui.git"
  },
  "bugs": {
    "url": "https://github.com/Vaibhav91one/purrfect-ui/issues"
  },
  "license": "MIT",
  "author": "Vaibhav Tomar <https://vaibhavtomar.com>",
  "keywords": [
    "react",
    "shadcn",
    "registry",
    "animation",
    "motion",
    "tailwindcss",
    "components",
    "sound"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "registry:build": "shadcn build",
    "prebuild": "pnpm registry:build",
    "typecheck": "next typegen && tsc --noEmit",
    "capture": "node scripts/capture/capture.mjs",
    "check": "node scripts/check/check.mjs",
    "check:selftest": "node scripts/check/selftest.mjs",
    "check:perf": "node scripts/check/perf.mjs",
    "check:behaviour": "node scripts/check/behaviour.mjs"
  },
  "dependencies": {
    "@paper-design/shaders-react": "0.0.71",
    "clsx": "^2.1.1",
    "cuelume": "^0.2.8",
    "gsap": "^3.15.0",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "^2.0.8",
    "sugar-high": "^2.6.4",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "playwright-core": "^1.64.1",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.18.2"
}
