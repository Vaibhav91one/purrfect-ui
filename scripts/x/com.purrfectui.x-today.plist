<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Daily X post helper. Install with `pnpm x:install`, remove with `pnpm x:uninstall`.
     launchd runs a missed StartCalendarInterval job when the Mac wakes, which cron does not. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.purrfectui.x-today</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>/Users/vaibhavtomar/Desktop/purrfectui/scripts/x/run.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>10</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/vaibhavtomar/Library/Logs/purrfectui-x.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/vaibhavtomar/Library/Logs/purrfectui-x.log</string>
</dict>
</plist>
